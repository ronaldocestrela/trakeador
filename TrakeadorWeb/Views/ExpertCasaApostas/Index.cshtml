@model TrakeadorWeb.Models.Expert

@{
    ViewData["Title"] = "Casas de Apostas - " + Model.Nome;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Casas de Apostas</h1>
        <p class="text-muted">Expert: <strong>@Model.Nome</strong></p>
    </div>
    <div>
        <a asp-action="Create" asp-route-expertId="@Model.Id" class="btn btn-primary">
            <i class="fas fa-plus"></i> Associar Casa de Apostas
        </a>
        <a asp-controller="Experts" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Voltar ao Expert
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.Descricao))
{
    <div class="alert alert-info" role="alert">
        <i class="fas fa-info-circle"></i> @Model.Descricao
    </div>
}

@if (Model.CasasDeApostas.Any())
{
    <div class="row">
        @foreach (var item in Model.CasasDeApostas.Where(eca => eca.Ativo))
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            @{
                                string iconClass = item.CasaDeApostas.Nome.ToLower() switch
                                {
                                    "esportiva" => "fas fa-futbol text-success",
                                    "novibet" => "fas fa-trophy text-primary", 
                                    "betmgm" => "fas fa-dice text-warning",
                                    _ => "fas fa-home text-secondary"
                                };
                            }
                            <i class="@iconClass"></i> @item.CasaDeApostas.Nome
                        </h5>
                        <span class="badge bg-success">Ativa</span>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(item.CasaDeApostas.Descricao))
                        {
                            <p class="card-text small text-muted mb-3">@item.CasaDeApostas.Descricao</p>
                        }
                        
                        <div class="mb-3">
                            <strong>Código de Afiliado:</strong><br>
                            <code class="small">
                                @if (item.CodigoAfiliado.Length > 30)
                                {
                                    @(item.CodigoAfiliado.Substring(0, 30) + "...")
                                }
                                else
                                {
                                    @item.CodigoAfiliado
                                }
                            </code>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(item.ParametrosAdicionais))
                        {
                            <div class="mb-3">
                                <strong>Parâmetros Adicionais:</strong><br>
                                <code class="small">
                                    @if (item.ParametrosAdicionais.Length > 50)
                                    {
                                        @(item.ParametrosAdicionais.Substring(0, 50) + "...")
                                    }
                                    else
                                    {
                                        @item.ParametrosAdicionais
                                    }
                                </code>
                            </div>
                        }
                        
                        <small class="text-muted">
                            <i class="fas fa-calendar-alt"></i> Criado em @item.DataCriacao.ToString("dd/MM/yyyy")
                        </small>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group w-100" role="group">
                            <a asp-controller="LinkTracking" asp-action="Casa" 
                               asp-route-casaId="@item.CasaDeApostasId" 
                               asp-route-expertId="@item.ExpertId" 
                               class="btn btn-success btn-sm">
                                <i class="fas fa-link"></i> Links
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" 
                               class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" 
                               class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash"></i> Remover
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center" role="alert">
        <h4 class="alert-heading">
            <i class="fas fa-info-circle"></i> Nenhuma casa de apostas associada
        </h4>
        <p>Este expert ainda não possui casas de apostas configuradas.</p>
        <hr>
        <a asp-action="Create" asp-route-expertId="@Model.Id" class="btn btn-primary">
            <i class="fas fa-plus"></i> Associar primeira casa de apostas
        </a>
    </div>
}

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle"></i> Sobre as Casas de Apostas
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-futbol fa-2x text-success mb-2"></i>
                            <h6>Esportiva</h6>
                            <p class="small text-muted">Adiciona parâmetros de rastreamento aos links existentes</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-trophy fa-2x text-primary mb-2"></i>
                            <h6>Novibet</h6>
                            <p class="small text-muted">Cria links de redirecionamento personalizados</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-dice fa-2x text-warning mb-2"></i>
                            <h6>BetMGM</h6>
                            <p class="small text-muted">Transforma códigos em links de cupons</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>