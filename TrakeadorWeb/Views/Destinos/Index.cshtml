@model IEnumerable<TrakeadorWeb.Models.Destino>

@{
    ViewData["Title"] = "Destinos";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1 class="display-4">
                <i class="fas fa-map-marker-alt text-success"></i> Destinos
            </h1>
            <p class="text-muted">Gerencie os destinos específicos dos seus canais</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus"></i> Novo Destino
            </a>
            <a asp-controller="Canais" asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-broadcast-tower"></i> Gerenciar Canais
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="card shadow">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>
                                            <i class="fas fa-map-pin"></i> Destino
                                        </th>
                                        <th>
                                            <i class="fas fa-broadcast-tower"></i> Canal
                                        </th>
                                        <th class="text-end">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var groupedByCanal = Model.GroupBy(d => d.Canal.Nome);
                                    }
                                    @foreach (var canalGroup in groupedByCanal)
                                    {
                                        var isFirst = true;
                                        foreach (var item in canalGroup)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@item.Nome</strong>
                                                </td>
                                                <td>
                                                    @if (isFirst)
                                                    {
                                                        <span class="badge bg-primary">
                                                            <i class="fas fa-broadcast-tower"></i> @item.Canal.Nome
                                                        </span>
                                                        isFirst = false;
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <div class="btn-group" role="group">
                                                        <a asp-action="Details" asp-route-id="@item.Id" 
                                                           class="btn btn-sm btn-outline-info" 
                                                           title="Ver Detalhes">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        <a asp-action="Edit" asp-route-id="@item.Id" 
                                                           class="btn btn-sm btn-outline-primary" 
                                                           title="Editar">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <a asp-action="Delete" asp-route-id="@item.Id" 
                                                           class="btn btn-sm btn-outline-danger" 
                                                           title="Excluir">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-map-marker-alt fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">Nenhum destino cadastrado</h4>
                            <p class="text-muted">Destinos são locais específicos dentro de um canal</p>
                            <a asp-action="Create" class="btn btn-success">
                                <i class="fas fa-plus"></i> Criar Primeiro Destino
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}
