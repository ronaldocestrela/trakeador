@model TrakeadorWeb.Models.Destino

@{
    ViewData["Title"] = "Editar Destino";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <h1 class="display-5">
                <i class="fas fa-edit text-success"></i> Editar Destino
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Destinos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Editar</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-3">
                            <label asp-for="CanalId" class="form-label">
                                <i class="fas fa-broadcast-tower"></i> Canal
                            </label>
                            <select asp-for="CanalId" class="form-select" asp-items="ViewBag.CanalId">
                                <option value="">-- Selecione um Canal --</option>
                            </select>
                            <span asp-validation-for="CanalId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">
                                <i class="fas fa-map-pin"></i> Nome do Destino
                            </label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Salvar Alterações
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                                <i class="fas fa-eye"></i> Ver Detalhes
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-info-circle text-info"></i> Informações
                    </h5>
                    <p class="card-text">
                        <strong>Atenção:</strong><br>
                        Ao alterar o canal do destino, verifique se faz sentido no contexto da sua organização.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
