@model TrakeadorWeb.Models.Destino

@{
    ViewData["Title"] = "Detalhes do Destino";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <h1 class="display-5">
                <i class="fas fa-map-marker-alt text-success"></i> Detalhes do Destino
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Destinos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Detalhes</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-map-pin"></i> @Model.Nome
                    </h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">
                            <i class="fas fa-hashtag"></i> ID
                        </dt>
                        <dd class="col-sm-9">
                            @Model.Id
                        </dd>

                        <dt class="col-sm-3">
                            <i class="fas fa-map-pin"></i> Nome
                        </dt>
                        <dd class="col-sm-9">
                            @Model.Nome
                        </dd>

                        <dt class="col-sm-3">
                            <i class="fas fa-broadcast-tower"></i> Canal
                        </dt>
                        <dd class="col-sm-9">
                            <a asp-controller="Canais" asp-action="Details" asp-route-id="@Model.Canal.Id" 
                               class="badge bg-primary text-decoration-none">
                                @Model.Canal.Nome
                            </a>
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">
                    <i class="fas fa-edit"></i> Editar
                </a>
                <a asp-controller="Canais" asp-action="Details" asp-route-id="@Model.Canal.Id" class="btn btn-primary">
                    <i class="fas fa-broadcast-tower"></i> Ver Canal
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-info-circle text-info"></i> Informações
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <strong>Canal:</strong> @Model.Canal.Nome
                        </li>
                        <li class="mb-2">
                            <strong>Destino:</strong> @Model.Nome
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card bg-danger text-white mt-3">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-exclamation-triangle"></i> Zona de Perigo
                    </h5>
                    <p class="card-text small">
                        Excluir este destino removerá todos os dados associados.
                    </p>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-light btn-sm">
                        <i class="fas fa-trash"></i> Excluir Destino
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
