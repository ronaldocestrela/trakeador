@model TrakeadorWeb.Models.Destino

@{
    ViewData["Title"] = "Criar Destino";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <h1 class="display-5">
                <i class="fas fa-plus-circle text-success"></i> Criar Novo Destino
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Destinos</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Criar</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="CanalId" class="form-label">
                                <i class="fas fa-broadcast-tower"></i> Canal
                            </label>
                            <select asp-for="CanalId" class="form-select" asp-items="ViewBag.CanalId">
                                <option value="">-- Selecione um Canal --</option>
                            </select>
                            <span asp-validation-for="CanalId" class="text-danger"></span>
                            <div class="form-text">
                                Selecione o canal ao qual este destino pertence
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">
                                <i class="fas fa-map-pin"></i> Nome do Destino
                            </label>
                            <input asp-for="Nome" class="form-control" placeholder="Ex: Grupo VIP, Stories, Feed Principal" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                            <div class="form-text">
                                Digite o nome específico do destino dentro do canal
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Salvar
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-info-circle text-info"></i> Informações
                    </h5>
                    <p class="card-text">
                        <strong>O que são destinos?</strong><br>
                        Destinos são locais específicos dentro de um canal. Por exemplo:
                    </p>
                    <ul>
                        <li><strong>WhatsApp:</strong> Grupo VIP, Status, Contatos</li>
                        <li><strong>Instagram:</strong> Stories, Feed, Reels</li>
                        <li><strong>Telegram:</strong> Canal Principal, Grupo Premium</li>
                    </ul>
                    <hr>
                    <p class="card-text">
                        <strong>Dica:</strong><br>
                        Use nomes descritivos para facilitar a identificação dos destinos.
                    </p>
                </div>
            </div>

            <div class="card bg-warning mt-3">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-exclamation-triangle"></i> Atenção
                    </h5>
                    <p class="card-text small">
                        Você precisa ter pelo menos um canal cadastrado antes de criar destinos.
                    </p>
                    <a asp-controller="Canais" asp-action="Create" class="btn btn-dark btn-sm">
                        <i class="fas fa-plus"></i> Criar Canal
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
