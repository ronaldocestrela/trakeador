@model IEnumerable<TrakeadorWeb.Models.CasaDeApostas>

@{
    ViewData["Title"] = "Casas de Apostas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted">Gerencie as casas de apostas do sistema</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nova Casa de Apostas
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-home"></i> @item.Nome
                        </h5>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="fas fa-eye"></i> Ver Detalhes
                                </a></li>
                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="fas fa-edit"></i> Editar
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="fas fa-trash"></i> Excluir
                                </a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-body d-flex flex-column">
                        @if (!string.IsNullOrEmpty(item.Descricao))
                        {
                            <p class="card-text text-muted mb-3">@item.Descricao</p>
                        }
                        else
                        {
                            <p class="card-text text-muted mb-3"><em>Sem descrição</em></p>
                        }

                        @if (!string.IsNullOrEmpty(item.UrlBase))
                        {
                            <p class="card-text small">
                                <strong>URL Base:</strong><br>
                                <code class="text-break">@item.UrlBase</code>
                            </p>
                        }

                        <div class="mt-auto">
                            <small class="text-muted">
                                <i class="fas fa-calendar"></i> Criado em @item.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle"></i> Ativa
                            </span>
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Ver Detalhes">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="mb-3">
            <i class="fas fa-home fa-3x text-muted"></i>
        </div>
        <h3 class="text-muted">Nenhuma casa de apostas encontrada</h3>
        <p class="text-muted mb-4">Comece criando sua primeira casa de apostas para o sistema.</p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Criar Primeira Casa de Apostas
        </a>
    </div>
}