@model TrakeadorWeb.Models.CasaDeApostas

@{
    ViewData["Title"] = "Nova Casa de Apostas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted">Adicione uma nova casa de apostas ao sistema</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Voltar à Lista
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="fas fa-home"></i> Informações da Casa de Apostas
                </h4>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" placeholder="Ex: Betano, Bet365, etc." />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                    <div class="form-text">
                        Nome único da casa de apostas (obrigatório)
                    </div>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Breve descrição sobre a casa de apostas..."></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                    <div class="form-text">
                        Descrição opcional da casa de apostas
                    </div>
                </div>
                
                <div class="mb-3">
                    <label asp-for="UrlBase" class="form-label"></label>
                    <input asp-for="UrlBase" class="form-control" placeholder="https://exemplo.com" />
                    <span asp-validation-for="UrlBase" class="text-danger"></span>
                    <div class="form-text">
                        URL base da casa de apostas (opcional)
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Salvar Casa de Apostas
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i> Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle"></i> Dicas
                </h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <i class="fas fa-check text-success"></i>
                        <strong>Nome:</strong> Use o nome oficial da casa de apostas
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success"></i>
                        <strong>Descrição:</strong> Adicione informações úteis para identificação
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check text-success"></i>
                        <strong>URL Base:</strong> Facilita a configuração de links
                    </li>
                    <li class="mb-0">
                        <i class="fas fa-lightbulb text-warning"></i>
                        <strong>Lembrete:</strong> Você poderá editar essas informações posteriormente
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}