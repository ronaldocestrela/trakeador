@model TrakeadorWeb.Models.CasaDeApostas

@{
    ViewData["Title"] = "Detalhes - " + Model.Nome;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.Nome</h1>
        @if (!string.IsNullOrEmpty(Model.Descricao))
        {
            <p class="text-muted">@Model.Descricao</p>
        }
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Voltar à Lista
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="fas fa-info-circle"></i> Informações Gerais
                </h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9"><code>@Model.Id</code></dd>
                    
                    <dt class="col-sm-3">Nome</dt>
                    <dd class="col-sm-9"><strong>@Model.Nome</strong></dd>
                    
                    @if (!string.IsNullOrEmpty(Model.Descricao))
                    {
                        <dt class="col-sm-3">Descrição</dt>
                        <dd class="col-sm-9">@Model.Descricao</dd>
                    }
                    
                    @if (!string.IsNullOrEmpty(Model.UrlBase))
                    {
                        <dt class="col-sm-3">URL Base</dt>
                        <dd class="col-sm-9">
                            <code class="text-break">@Model.UrlBase</code>
                            @if (Uri.TryCreate(Model.UrlBase, UriKind.Absolute, out var uri))
                            {
                                <br>
                                <a href="@Model.UrlBase" target="_blank" class="btn btn-sm btn-outline-primary mt-1">
                                    <i class="fas fa-external-link-alt"></i> Abrir Site
                                </a>
                            }
                        </dd>
                    }
                    
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        @if (Model.Ativo)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle"></i> Ativa
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                <i class="fas fa-times-circle"></i> Inativa
                            </span>
                        }
                    </dd>
                    
                    <dt class="col-sm-3">Data de Criação</dt>
                    <dd class="col-sm-9">@Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        @if (Model.Experts.Any())
        {
            <div class="card mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-users"></i> Experts Associados
                    </h5>
                    <span class="badge bg-primary">@Model.Experts.Count</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var expertAssociacao in Model.Experts)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card border-light">
                                    <div class="card-body p-3">
                                        <h6 class="card-title">
                                            <i class="fas fa-user"></i> @expertAssociacao.Expert.Nome
                                        </h6>
                                        <p class="card-text small text-muted mb-2">
                                            <strong>Código:</strong> <code>@expertAssociacao.CodigoAfiliado</code>
                                        </p>
                                        @if (!string.IsNullOrEmpty(expertAssociacao.ParametrosAdicionais))
                                        {
                                            <p class="card-text small text-muted mb-2">
                                                <strong>Parâmetros:</strong> <code>@expertAssociacao.ParametrosAdicionais</code>
                                            </p>
                                        }
                                        <small class="text-muted">
                                            <i class="fas fa-calendar"></i> Desde @expertAssociacao.DataCriacao.ToString("dd/MM/yyyy")
                                        </small>
                                    </div>
                                    <div class="card-footer p-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="badge bg-success small">
                                                <i class="fas fa-check-circle"></i> Ativo
                                            </span>
                                            <div class="btn-group btn-group-sm">
                                                <a asp-controller="Experts" asp-action="Details" asp-route-id="@expertAssociacao.ExpertId" class="btn btn-outline-primary btn-sm" title="Ver Expert">
                                                    <i class="fas fa-user"></i>
                                                </a>
                                                <a asp-controller="LinkTracking" asp-action="Casa" asp-route-casaId="@Model.Id" asp-route-expertId="@expertAssociacao.ExpertId" class="btn btn-outline-success btn-sm" title="Gerar Links">
                                                    <i class="fas fa-link"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card mt-4">
                <div class="card-body text-center py-4">
                    <i class="fas fa-users fa-2x text-muted mb-3"></i>
                    <h5 class="text-muted">Nenhum expert associado</h5>
                    <p class="text-muted mb-3">Esta casa de apostas ainda não possui experts associados.</p>
                    <a asp-controller="Experts" asp-action="Index" class="btn btn-outline-primary">
                        <i class="fas fa-users"></i> Ver Experts Disponíveis
                    </a>
                </div>
            </div>
        }
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-cogs"></i> Ações
                </h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Editar Informações
                    </a>
                    
                    @if (Model.Experts.Any())
                    {
                        <button type="button" class="btn btn-outline-danger" disabled title="Não é possível excluir - possui experts associados">
                            <i class="fas fa-trash"></i> Excluir (Bloqueado)
                        </button>
                        <small class="text-muted">
                            <i class="fas fa-info-circle"></i> 
                            Para excluir, remova todas as associações com experts primeiro.
                        </small>
                    }
                    else
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="fas fa-trash"></i> Excluir Casa
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-chart-bar"></i> Estatísticas
                </h5>
            </div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt class="small text-muted">Experts Associados</dt>
                    <dd class="h5 mb-2 text-primary">@Model.Experts.Count</dd>
                    
                    <dt class="small text-muted">Data de Cadastro</dt>
                    <dd class="mb-2">@Model.DataCriacao.ToString("dd/MM/yyyy")</dd>
                    
                    <dt class="small text-muted">Dias no Sistema</dt>
                    <dd class="mb-0">@((DateTime.Now - Model.DataCriacao).Days) dias</dd>
                </dl>
            </div>
        </div>
    </div>
</div>