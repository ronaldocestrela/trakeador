@model TrakeadorWeb.Models.CasaDeApostas

@{
    ViewData["Title"] = "Editar - " + Model.Nome;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Editar Casa de Apostas</h1>
        <p class="text-muted">@Model.Nome</p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
            <i class="fas fa-eye"></i> Ver Detalhes
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Voltar à Lista
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="fas fa-edit"></i> Informações da Casa de Apostas
                </h4>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DataCriacao" />
                <input type="hidden" asp-for="Ativo" />
                
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                    <div class="form-text">
                        Nome único da casa de apostas (obrigatório)
                    </div>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                    <div class="form-text">
                        Descrição opcional da casa de apostas
                    </div>
                </div>
                
                <div class="mb-3">
                    <label asp-for="UrlBase" class="form-label"></label>
                    <input asp-for="UrlBase" class="form-control" />
                    <span asp-validation-for="UrlBase" class="text-danger"></span>
                    <div class="form-text">
                        URL base da casa de apostas (opcional)
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Salvar Alterações
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                        <i class="fas fa-eye"></i> Ver Detalhes
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i> Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle"></i> Informações
                </h5>
            </div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt>ID</dt>
                    <dd class="mb-2"><code>@Model.Id</code></dd>
                    
                    <dt>Data de Criação</dt>
                    <dd class="mb-2">@Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")</dd>
                    
                    <dt>Status</dt>
                    <dd class="mb-0">
                        @if (Model.Ativo)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle"></i> Ativa
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                <i class="fas fa-times-circle"></i> Inativa
                            </span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-exclamation-triangle text-warning"></i> Atenção
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    <strong>Alterar o nome:</strong> Pode afetar experts já associados a esta casa de apostas.
                </p>
                <p class="card-text mb-0">
                    <strong>URL Base:</strong> Mudanças podem impactar a geração de links rastreados.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}