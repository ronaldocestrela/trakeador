@model TrakeadorWeb.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Redefinir Senha";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Voltar
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <form asp-action="ResetPassword" class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="fas fa-key"></i> Nova Senha para @Model.Email
                </h4>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />
                
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i>
                    Você está redefinindo a senha para o usuário <strong>@Model.Email</strong>
                </div>
                
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input asp-for="NewPassword" class="form-control" placeholder="Digite a nova senha" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirme a nova senha" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-key"></i> Redefinir Senha
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-shield-alt"></i> Política de Senhas
                </h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled small">
                    <li><i class="fas fa-check text-success"></i> Mínimo 6 caracteres</li>
                    <li><i class="fas fa-check text-success"></i> Pelo menos 1 letra maiúscula</li>
                    <li><i class="fas fa-check text-success"></i> Pelo menos 1 letra minúscula</li>
                    <li><i class="fas fa-check text-success"></i> Pelo menos 1 número</li>
                </ul>
            </div>
        </div>
        
        <div class="alert alert-warning mt-3" role="alert">
            <h6 class="alert-heading">
                <i class="fas fa-exclamation-triangle"></i> Importante
            </h6>
            <p class="small mb-0">
                O usuário precisará usar esta nova senha no próximo login. Certifique-se de comunicar a alteração para o usuário.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}