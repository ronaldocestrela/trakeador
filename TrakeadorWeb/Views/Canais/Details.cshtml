@model TrakeadorWeb.Models.Canal

@{
    ViewData["Title"] = "Detalhes do Canal";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <h1 class="display-5">
                <i class="fas fa-broadcast-tower text-primary"></i> Detalhes do Canal
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Canais</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Detalhes</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@Model.Nome</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">
                            <i class="fas fa-hashtag"></i> ID
                        </dt>
                        <dd class="col-sm-9">
                            @Model.Id
                        </dd>

                        <dt class="col-sm-3">
                            <i class="fas fa-tag"></i> Nome
                        </dt>
                        <dd class="col-sm-9">
                            @Model.Nome
                        </dd>

                        <dt class="col-sm-3">
                            <i class="fas fa-map-marker-alt"></i> Total de Destinos
                        </dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-info">@Model.Destinos.Count</span>
                        </dd>
                    </dl>

                    @if (Model.Destinos.Any())
                    {
                        <hr>
                        <h5><i class="fas fa-list"></i> Destinos Cadastrados</h5>
                        <div class="list-group mt-3">
                            @foreach (var destino in Model.Destinos.OrderBy(d => d.Nome))
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between align-items-center">
                                        <h6 class="mb-0">
                                            <i class="fas fa-map-pin text-info"></i> @destino.Nome
                                        </h6>
                                        <a asp-controller="Destinos" asp-action="Details" asp-route-id="@destino.Id" 
                                           class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i> Ver
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-3">
                            <i class="fas fa-info-circle"></i> Este canal ainda não possui destinos cadastrados.
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Editar
                </a>
                <a asp-controller="Destinos" asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus"></i> Adicionar Destino
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-chart-bar text-success"></i> Estatísticas
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <strong>Destinos:</strong> @Model.Destinos.Count
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card bg-danger text-white mt-3">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-exclamation-triangle"></i> Zona de Perigo
                    </h5>
                    <p class="card-text small">
                        Excluir este canal removerá todos os dados associados.
                    </p>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-light btn-sm">
                        <i class="fas fa-trash"></i> Excluir Canal
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
