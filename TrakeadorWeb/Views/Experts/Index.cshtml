@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@model IEnumerable<TrakeadorWeb.Models.Expert>

@{
    ViewData["Title"] = "Experts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    @if (SignInManager.IsSignedIn(User))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Novo Expert
        </a>
    }
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@Html.DisplayFor(modelItem => item.Nome)</h5>
                    <p class="card-text flex-grow-1">
                        @if (!string.IsNullOrEmpty(item.Descricao))
                        {
                            @item.Descricao
                        }
                        else
                        {
                            <em class="text-muted">Sem descrição</em>
                        }
                    </p>
                    <small class="text-muted mb-3">
                        Criado em: @item.DataCriacao.ToString("dd/MM/yyyy")
                    </small>
                    <div class="btn-group" role="group">
                        <a asp-controller="LinkTracking" asp-action="Expert" asp-route-id="@item.Id" 
                           class="btn btn-success btn-sm">
                            <i class="fas fa-link"></i> Links
                        </a>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <a asp-controller="ExpertCasaApostas" asp-action="Index" asp-route-expertId="@item.Id" 
                               class="btn btn-info btn-sm">
                                <i class="fas fa-cog"></i> Casas
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-trash"></i> Excluir
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center" role="alert">
        <h4 class="alert-heading">Nenhum expert encontrado</h4>
        <p>Ainda não há experts cadastrados no sistema.</p>
        <hr>
        <a asp-action="Create" class="btn btn-primary">Cadastrar primeiro expert</a>
    </div>
}