@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@model TrakeadorWeb.Models.Expert

@{
    ViewData["Title"] = "Detalhes do Expert";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <div>
        @if (SignInManager.IsSignedIn(User))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Editar
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Voltar
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Informações Gerais</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Nome</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>
                    
                    <dt class="col-sm-3">Descrição</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrEmpty(Model.Descricao))
                        {
                            @Html.DisplayFor(model => model.Descricao)
                        }
                        else
                        {
                            <em class="text-muted">Sem descrição</em>
                        }
                    </dd>
                    
                    <dt class="col-sm-3">Data de Criação</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.DataCriacao)</dd>
                    
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        @if (Model.Ativo)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inativo</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (Model.CasasDeApostas.Any())
        {
            <div class="card mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-home"></i> Casas de Apostas Configuradas
                    </h5>
                    <span class="badge bg-primary">@Model.CasasDeApostas.Count(eca => eca.Ativo)</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var item in Model.CasasDeApostas.Where(eca => eca.Ativo))
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card border-light">
                                    <div class="card-body p-3">
                                        <h6 class="card-title">@item.CasaDeApostas.Nome</h6>
                                        <p class="card-text small text-muted mb-2">
                                            <strong>Código:</strong> 
                                            <code>@(item.CodigoAfiliado.Length > 15 ? item.CodigoAfiliado.Substring(0, 15) + "..." : item.CodigoAfiliado)</code>
                                        </p>
                                        <a asp-controller="LinkTracking" asp-action="Casa" 
                                           asp-route-casaId="@item.CasaDeApostasId" 
                                           asp-route-expertId="@item.ExpertId" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-link"></i> Gerar Links
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-4" role="alert">
                <h5 class="alert-heading">
                    <i class="fas fa-info-circle"></i> Nenhuma casa de apostas configurada
                </h5>
                <p class="mb-0">Este expert ainda não possui casas de apostas configuradas. Entre em contato com o administrador para adicionar casas de apostas.</p>
            </div>
        }
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-chart-bar"></i> Estatísticas
                </h6>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-12 mb-3">
                        <h4 class="text-primary">@Model.CasasDeApostas.Count(eca => eca.Ativo)</h4>
                        <small class="text-muted">Casas Ativas</small>
                    </div>
                    <div class="col-12">
                        <h4 class="text-info">@((DateTime.Now - Model.DataCriacao).Days)</h4>
                        <small class="text-muted">Dias no Sistema</small>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-tools"></i> Ações Rápidas
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="LinkTracking" asp-action="Expert" asp-route-id="@Model.Id" 
                       class="btn btn-success">
                        <i class="fas fa-link"></i> Ver Todas as Casas
                    </a>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <a asp-controller="ExpertCasaApostas" asp-action="Index" asp-route-expertId="@Model.Id" 
                           class="btn btn-info">
                            <i class="fas fa-cog"></i> Gerenciar Casas de Apostas
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            <i class="fas fa-edit"></i> Editar Expert
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="fas fa-trash"></i> Excluir Expert
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>