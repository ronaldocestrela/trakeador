@model TrakeadorWeb.Models.Expert

@{
    ViewData["Title"] = "Casas de Apostas - " + Model.Nome;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.Nome</h1>
        @if (!string.IsNullOrEmpty(Model.Descricao))
        {
            <p class="text-muted">@Model.Descricao</p>
        }
    </div>
    <a asp-controller="Experts" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Voltar para Experts
    </a>
</div>

<h3>Casas de Apostas Disponíveis</h3>

<div class="row">
    @foreach (var item in Model.CasasDeApostas.Where(eca => eca.Ativo))
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.CasaDeApostas.Nome</h5>
                    <p class="card-text flex-grow-1">
                        @if (!string.IsNullOrEmpty(item.CasaDeApostas.Descricao))
                        {
                            @item.CasaDeApostas.Descricao
                        }
                        else
                        {
                            <em class="text-muted">Sem descrição</em>
                        }
                    </p>
                    <div class="mb-2">
                        <small class="text-muted">
                            <strong>Código Afiliado:</strong> 
                            <code>@(item.CodigoAfiliado.Length > 20 ? item.CodigoAfiliado.Substring(0, 20) + "..." : item.CodigoAfiliado)</code>
                        </small>
                    </div>
                    <a asp-action="Casa" asp-route-casaId="@item.CasaDeApostasId" asp-route-expertId="@item.ExpertId" 
                       class="btn btn-primary">
                        <i class="fas fa-link"></i> Gerar Link Rastreado
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.CasasDeApostas.Any(eca => eca.Ativo))
{
    <div class="alert alert-info text-center" role="alert">
        <h4 class="alert-heading">Nenhuma casa de apostas configurada</h4>
        <p>Este expert ainda não possui casas de apostas configuradas.</p>
        <hr>
        <p class="mb-0">Entre em contato com o administrador para configurar as casas de apostas.</p>
    </div>
}