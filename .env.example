# Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para .env e modifique conforme necessário

# Configuração da aplicação
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Porta externa (onde a aplicação será acessível)
EXTERNAL_PORT=8080

# Nome do container
CONTAINER_NAME=trakeador-web

# Volume do banco de dados
DB_VOLUME=trakeador-data

# Configurações de log (opcional)
# Logging__LogLevel__Default=Information
# Logging__LogLevel__Microsoft.AspNetCore=Warning

# Para produção, configure estas variáveis:
# - Use HTTPS
# - Configure proxy reverso (nginx/traefik)
# - Configure backup automático
# - Configure monitoramento